# Local free PostgreSQL example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mental_wellness

APP_NAME=AI Mental Wellness Platform
ENV=development

# Generate a real one with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit the real value â€” this file only shows the variable name.
SECRET_KEY=replace-with-a-unique-secret-for-local-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production notes:
# - Use a real PostgreSQL database (Neon/Supabase/Render). SQLite is not recommended for production.
# - Set ENV=production and generate a strong SECRET_KEY.
# - Configure email (SMTP) or a provider for verification/reset emails.
# - CORS: set CORS_ORIGINS to your frontend URL(s) (comma-separated).
# - For scheduled reminders, run backend/run_reminders.py every 5 minutes via cron/Task Scheduler.
# - Set FRONTEND_URL to the frontend base URL used in verification/reset email links.
#   Locally this is http://localhost:5173; at deployment set it to the real
#   HTTPS frontend domain (for example https://your-frontend-domain).
